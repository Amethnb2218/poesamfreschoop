# Copiez ce fichier en .env et renseignez vos valeurs.
# .env est ignore par git : ne commitez jamais de cle reelle.

# --- Base de donnees ------------------------------------------------------
# Laissez vide en developpement : le serveur basculera sur un fichier SQLite
# local (server/data/frescoop.db). En production (NODE_ENV=production), ces
# deux variables sont obligatoires et le serveur refuse de demarrer sans elles.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Securite -------------------------------------------------------------
# Secret de signature des jetons de session. Generez une valeur aleatoire.
TOKEN_SECRET=
# Origines autorisees en CORS, separees par des virgules. Vide = toutes.
CORS_ORIGINS=

# --- Serveur --------------------------------------------------------------
PORT=4174
FRESCOOP_HOST=127.0.0.1

# --- Assistant FresCoop et Conseiller agricole ----------------------------
# Cle OpenRouter. Sans elle, le conseiller agricole repond quand meme via son
# moteur de reponses local (hors-ligne), mais l'assistant generaliste renvoie 503.
OPENROUTER_API_KEY=
# Modeles essayes dans l'ordre (optionnel).
OPENROUTER_MODELS=openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# --- Prediction agronomique -----------------------------------------------
# Optionnel. Sans cle, les predictions utilisent les moyennes climatiques
# ANACIM ; avec cle, la meteo temps reel est injectee dans le modele.
OPENWEATHER_API_KEY=

# --- Paiement MaxIt -------------------------------------------------------
MAXIT_MODE=test
MAXIT_MASTER_KEY=
MAXIT_PRIVATE_KEY=
MAXIT_PUBLIC_KEY=
MAXIT_TOKEN=

# --- Upload Cloudinary ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
